{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belloria-assistant",
  "main": "worker/src/entry.js",
  "compatibility_date": "2026-08-03",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "belloria-whatsapp",
      "database_id": "7e14b969-fd11-4c9b-88ab-7776321914cd",
      "migrations_dir": "worker/migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "cca73f4814794f52b8b04dc743b30f51"
    }
  ],
  "observability": { "enabled": true }
}
