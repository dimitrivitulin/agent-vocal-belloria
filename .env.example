# Copier vers .env puis remplacer toutes les valeurs change-me.
WAHA_API_KEY=change-me-use-a-long-random-value
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-use-a-long-random-value
WAHA_WEBHOOK_HMAC_KEY=change-me-use-a-long-random-value
BELLORIA_MCP_TOKEN=change-me-use-a-long-random-value
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default

# Exemple inactif pour BELL-012 ; ne jamais committer de jeton réel.
WHATSAPP_PROVIDER=disabled
META_PHONE_NUMBER_ID=change-me
META_ACCESS_TOKEN=change-me-use-a-system-user-token
META_GRAPH_VERSION=change-me-to-a-supported-version
