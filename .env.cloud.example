# Copier vers .env.cloud sur l'hote. Ne jamais committer le fichier reel.
BELLORIA_MCP_DOMAIN=mcp.example.com
ACME_EMAIL=admin@example.com

# Ampere A1 (ARM64). Pour une VM x86_64, utiliser noweb-2026.6.1.
WAHA_IMAGE=devlikeapro/waha:noweb-arm-2026.6.1
WAHA_API_KEY=change-me-generate-at-least-32-random-bytes
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-generate-at-least-32-random-bytes
WAHA_WEBHOOK_HMAC_KEY=change-me-generate-at-least-32-random-bytes
BELLORIA_MCP_TOKEN=change-me-generate-at-least-32-random-bytes
WAHA_SESSION=belloria-test
